{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "xScp: Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    }
  ]
}
