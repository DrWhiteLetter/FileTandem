{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FileTandem: Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "FileTandem: Remote-SSH-Ausführungsort prüfen",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--folder-uri=vscode-remote://ssh-remote+${input:xscpTestHost}${input:xscpTestFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    }
  ],
  "inputs": [
    {
      "id": "xscpTestHost",
      "type": "promptString",
      "description": "SSH-Hostalias eines freigegebenen isolierten Testservers"
    },
    {
      "id": "xscpTestFolder",
      "type": "promptString",
      "description": "Existierender absoluter POSIX-Testordner auf dem SSH-Testserver",
      "default": "/tmp"
    }
  ]
}
