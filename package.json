{
  "name": "filetandem",
  "displayName": "FileTandem – SFTP/SCP File Manager",
  "description": "%description%",
  "version": "1.0.3",
  "private": true,
  "publisher": "RootShellForge",
  "type": "module",
  "engines": {
    "vscode": "^1.140.0",
    "node": ">=22.13.1"
  },
  "main": "./dist/extension.cjs",
  "icon": "media/filetandem-marketplace-icon.png",
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "filetandem.openManager",
        "title": "%filetandem.openManager.title%",
        "icon": "media/filetandem-button.png"
      },
      {
        "command": "filetandem.verifyLocalFile",
        "title": "%filetandem.verifyLocalFile.title%"
      },
      {
        "command": "filetandem.verifySshHostKey",
        "title": "%filetandem.verifySshHostKey.title%"
      },
      {
        "command": "filetandem.openEditorProof",
        "title": "%filetandem.openEditorProof.title%"
      },
      {
        "command": "filetandem.enableEditorEditing",
        "title": "%filetandem.enableEditorEditing.title%"
      },
      {
        "command": "filetandem.lockEditorFile",
        "title": "%filetandem.lockEditorFile.title%"
      },
      {
        "command": "filetandem.refreshConnections",
        "title": "%filetandem.refreshConnections.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "filetandem.addProfile",
        "title": "%filetandem.addProfile.title%",
        "icon": "$(add)"
      },
      {
        "command": "filetandem.editProfile",
        "title": "%filetandem.editProfile.title%"
      },
      {
        "command": "filetandem.deleteProfile",
        "title": "%filetandem.deleteProfile.title%"
      },
      {
        "command": "filetandem.exportProfiles",
        "title": "%filetandem.exportProfiles.title%"
      },
      {
        "command": "filetandem.forgetCredentials",
        "title": "%filetandem.forgetCredentials.title%"
      },
      {
        "command": "filetandem.connectProfile",
        "title": "%filetandem.connectProfile.title%"
      },
      {
        "command": "filetandem.disconnectProfile",
        "title": "%filetandem.disconnectProfile.title%"
      },
      {
        "command": "filetandem.openDemo",
        "title": "%filetandem.openDemo.title%"
      },
      {
        "command": "filetandem.openProfile",
        "title": "%filetandem.openProfile.title%",
        "icon": "$(plug)"
      },
      {
        "command": "filetandem.quickConnect",
        "title": "%filetandem.quickConnect.title%",
        "icon": "$(plug)"
      },
      {
        "command": "filetandem.favoriteProfile",
        "title": "%filetandem.favoriteProfile.title%",
        "icon": "$(star-empty)"
      },
      {
        "command": "filetandem.reconnectProfile",
        "title": "%filetandem.reconnectProfile.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "filetandem.showTransfers",
        "title": "%filetandem.showTransfers.title%"
      },
      {
        "command": "filetandem.uploadFromExplorer",
        "title": "%filetandem.uploadFromExplorer.title%"
      },
      {
        "command": "filetandem.newRemoteFile",
        "title": "%filetandem.newRemoteFile.title%"
      },
      {
        "command": "filetandem.reviewRemoteFile",
        "title": "%filetandem.reviewRemoteFile.title%"
      },
      {
        "command": "filetandem.acceptEditorReview",
        "title": "%filetandem.acceptEditorReview.title%"
      },
      {
        "command": "filetandem.diffRemoteFile",
        "title": "%filetandem.diffRemoteFile.title%"
      },
      {
        "command": "filetandem.newSession",
        "title": "%filetandem.newSession.title%"
      },
      {
        "command": "filetandem.uploadEditorCopy",
        "title": "%filetandem.uploadEditorCopy.title%"
      },
      {
        "command": "filetandem.removeEditorCopy",
        "title": "%filetandem.removeEditorCopy.title%"
      },
      {
        "command": "filetandem.openEditorCopy",
        "title": "%filetandem.openEditorCopy.title%"
      },
      {
        "command": "filetandem.consumeCommanderKey",
        "title": "%filetandem.consumeCommanderKey.title%"
      },
      {
        "command": "filetandem.copySelection",
        "title": "%filetandem.copySelection.title%"
      },
      {
        "command": "filetandem.openSettings",
        "title": "%filetandem.openSettings.title%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "filetandem",
          "title": "FileTandem",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "filetandem": [
        {
          "id": "filetandem.connections",
          "name": "%connections.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "filetandem.openManager",
          "when": "view == filetandem.connections",
          "group": "navigation@0"
        },
        {
          "command": "filetandem.refreshConnections",
          "when": "view == filetandem.connections",
          "group": "navigation"
        },
        {
          "command": "filetandem.addProfile",
          "when": "view == filetandem.connections",
          "group": "navigation"
        },
        {
          "command": "filetandem.quickConnect",
          "when": "view == filetandem.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "filetandem.openProfile",
          "when": "view == filetandem.connections && viewItem == filetandemProfile",
          "group": "filetandem"
        },
        {
          "command": "filetandem.reconnectProfile",
          "when": "view == filetandem.connections && viewItem == filetandemProfile",
          "group": "filetandem"
        },
        {
          "command": "filetandem.disconnectProfile",
          "when": "view == filetandem.connections && viewItem == filetandemProfile",
          "group": "filetandem"
        },
        {
          "command": "filetandem.editProfile",
          "when": "view == filetandem.connections && viewItem == filetandemProfile",
          "group": "filetandem"
        },
        {
          "command": "filetandem.favoriteProfile",
          "when": "view == filetandem.connections && viewItem == filetandemProfile",
          "group": "filetandem"
        },
        {
          "command": "filetandem.deleteProfile",
          "when": "view == filetandem.connections && viewItem == filetandemProfile",
          "group": "filetandem"
        }
      ],
      "explorer/context": [
        {
          "command": "filetandem.uploadFromExplorer",
          "when": "resourceScheme == file",
          "group": "filetandem"
        }
      ],
      "editor/title": [
        {
          "command": "filetandem.enableEditorEditing",
          "when": "resourceScheme == filetandem || resourceScheme == filetandem-remote",
          "group": "filetandem"
        },
        {
          "command": "filetandem.lockEditorFile",
          "when": "resourceScheme == filetandem || resourceScheme == filetandem-remote",
          "group": "filetandem"
        },
        {
          "command": "filetandem.reviewRemoteFile",
          "when": "resourceScheme == filetandem || resourceScheme == filetandem-review",
          "group": "filetandem"
        },
        {
          "command": "filetandem.acceptEditorReview",
          "when": "resourceScheme == filetandem || resourceScheme == filetandem-review",
          "group": "filetandem"
        },
        {
          "command": "filetandem.diffRemoteFile",
          "when": "resourceScheme == filetandem || resourceScheme == filetandem-review",
          "group": "filetandem"
        },
        {
          "command": "filetandem.uploadEditorCopy",
          "when": "filetandem.editorCopyActive",
          "group": "filetandem"
        },
        {
          "command": "filetandem.removeEditorCopy",
          "when": "filetandem.editorCopyActive",
          "group": "filetandem"
        }
      ],
      "commandPalette": [
        {
          "command": "filetandem.consumeCommanderKey",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "FileTandem",
        "properties": {
          "filetandem.showHiddenFiles": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "description": "%filetandem.showHiddenFiles.description%",
            "title": "%filetandem.showHiddenFiles.title%"
          },
          "filetandem.demoScenario": {
            "type": "string",
            "enum": [
              "ready",
              "loading",
              "empty",
              "error",
              "disconnected"
            ],
            "default": "ready",
            "scope": "application",
            "description": "%filetandem.demoScenario.description%",
            "title": "%filetandem.demoScenario.title%"
          },
          "filetandem.editorPollInterval": {
            "type": "integer",
            "default": 5,
            "minimum": 2,
            "maximum": 60,
            "scope": "application",
            "description": "%filetandem.editorPollInterval.description%",
            "title": "%filetandem.editorPollInterval.title%"
          },
          "filetandem.commanderKeys": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "description": "%filetandem.commanderKeys.description%",
            "title": "%filetandem.commanderKeys.title%"
          },
          "filetandem.language": {
            "type": "string",
            "enum": [
              "auto",
              "de",
              "en"
            ],
            "default": "auto",
            "scope": "application",
            "description": "%filetandem.language.description%",
            "title": "%filetandem.language.title%",
            "enumDescriptions": [
              "%filetandem.language.auto%",
              "%filetandem.language.de%",
              "%filetandem.language.en%"
            ]
          },
          "filetandem.excludedExtensions": {
            "type": "array",
            "default": [],
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\*?\\.?[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            },
            "scope": "window",
            "description": "%filetandem.excludedExtensions.description%"
          },
          "filetandem.excludedNames": {
            "type": "array",
            "default": [
              ".git",
              ".vscode",
              ".env",
              ".env.*",
              "node_modules"
            ],
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^/\\\\\\r\\n]+$"
            },
            "scope": "window",
            "description": "%filetandem.excludedNames.description%"
          },
          "filetandem.excludeHidden": {
            "type": "boolean",
            "default": false,
            "scope": "window",
            "description": "%filetandem.excludeHidden.description%"
          },
          "filetandem.backupRemoteDeletes": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "description": "%filetandem.backupRemoteDeletes.description%"
          }
        },
        "id": "FileTandem"
      },
      {
        "id": "filetandem.security",
        "title": "%filetandem.security.title%",
        "order": 20,
        "properties": {
          "filetandem.sftpUploadVerification": {
            "type": "string",
            "enum": [
              "size",
              "sha256"
            ],
            "default": "size",
            "scope": "application",
            "description": "%filetandem.sftpUploadVerification.description%",
            "enumDescriptions": [
              "%filetandem.sftpUploadVerification.size%",
              "%filetandem.sftpUploadVerification.sha256%"
            ],
            "enumItemLabels": [
              "%filetandem.sftpUploadVerification.sizeLabel%",
              "%filetandem.sftpUploadVerification.sha256Label%"
            ]
          },
          "filetandem.checkUploadOwnership": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "title": "%filetandem.checkUploadOwnership.title%",
            "description": "%filetandem.checkUploadOwnership.description%"
          }
        }
      }
    ],
    "viewsWelcome": [
      {
        "view": "filetandem.connections",
        "contents": "%connections.welcome%"
      }
    ],
    "keybindings": [
      {
        "key": "f3",
        "command": "filetandem.consumeCommanderKey",
        "when": "activeWebviewPanelId == filetandem.browser && config.filetandem.commanderKeys"
      },
      {
        "key": "f4",
        "command": "filetandem.consumeCommanderKey",
        "when": "activeWebviewPanelId == filetandem.browser && config.filetandem.commanderKeys"
      },
      {
        "key": "f5",
        "command": "filetandem.copySelection",
        "when": "activeWebviewPanelId == filetandem.browser && config.filetandem.commanderKeys"
      },
      {
        "key": "f6",
        "command": "filetandem.consumeCommanderKey",
        "when": "activeWebviewPanelId == filetandem.browser && config.filetandem.commanderKeys"
      },
      {
        "key": "f7",
        "command": "filetandem.consumeCommanderKey",
        "when": "activeWebviewPanelId == filetandem.browser && config.filetandem.commanderKeys"
      },
      {
        "key": "f8",
        "command": "filetandem.consumeCommanderKey",
        "when": "activeWebviewPanelId == filetandem.browser && config.filetandem.commanderKeys"
      }
    ]
  },
  "scripts": {
    "test:migration": "node scripts/test-namespace-migration.mjs",
    "test:faults": "node scripts/test-faults.mjs",
    "test:release": "node scripts/test-release.mjs",
    "benchmark:small": "node scripts/benchmark-small-files.mjs",
    "benchmark:release": "node --expose-gc scripts/benchmark-release.mjs",
    "test:restricted": "node scripts/test-restricted.mjs",
    "test:editor:service": "node --test test/integration/editor.test.js",
    "test:integrity": "node --test --test-concurrency=1 test/integration/release-integrity.test.js",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && node scripts/start.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run test:unit && npm run build && node scripts/test-extension.mjs",
    "vscode:prepublish": "npm run build",
    "fixtures:init": "node scripts/ssh-fixtures.mjs init",
    "fixtures:start": "node scripts/ssh-fixtures.mjs start",
    "fixtures:stop": "node scripts/ssh-fixtures.mjs stop",
    "fixtures:reset": "node scripts/ssh-fixtures.mjs reset",
    "fixtures:verify": "node scripts/ssh-fixtures.mjs verify",
    "fixtures:status": "node scripts/ssh-fixtures.mjs status",
    "test:unit": "node --test test/unit/*.test.js",
    "test:host-keys": "node --test --test-concurrency=1 test/integration/host-keys.test.js",
    "test:sftp": "node --test --test-concurrency=1 test/integration/sftp-streaming.test.js",
    "test:scp": "node --test --test-concurrency=1 test/integration/scp.test.js",
    "test:auth": "node --test --test-concurrency=1 test/integration/authentication.test.js",
    "test:packaging": "node scripts/test-packaging.mjs",
    "test:editor": "node --test test/integration/editor.test.js && npm run build && node scripts/test-editor.mjs",
    "test:editor:remote": "npm run build && node scripts/test-editor.mjs --remote",
    "lint": "eslint .",
    "quality": "npm run l10n:check && npm run lint && npm run check && npm run test:unit && npm run test:webview && npm run build",
    "test:webview": "node --test test/webview/*.test.js",
    "package": "node scripts/package.mjs",
    "test:installed": "node scripts/test-installed.mjs",
    "test:auto-upload": "node --test --test-concurrency=1 test/integration/auto-upload.test.js",
    "test:browser": "node --test --test-concurrency=1 test/integration/browser.test.js",
    "test:browser:installed": "node scripts/test-browser-installed.mjs",
    "test:transfers": "node --test --test-concurrency=1 test/integration/transfers.test.js",
    "test:protocols": "node --test --test-concurrency=1 test/integration/host-keys.test.js test/integration/authentication.test.js test/integration/sftp-streaming.test.js test/integration/scp.test.js test/integration/scp-engine.test.js test/integration/transfers.test.js test/integration/resume.test.js test/integration/transfer-auth.test.js test/integration/browser.test.js test/integration/upload-ownership.test.js",
    "test:native:f5": "node scripts/test-native-f5.mjs",
    "preview:ui": "node scripts/preview-ui.mjs",
    "l10n:sync": "node scripts/sync-localization.mjs",
    "l10n:check": "node scripts/sync-localization.mjs --check",
    "test:localization": "node scripts/test-localization-installed.mjs",
    "test:file-options": "node --test --test-concurrency=1 test/integration/file-options.test.js"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/vscode": "1.138.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "27.4.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onWebviewPanel:filetandem.demo",
    "onWebviewPanel:filetandem.browser"
  ],
  "license": "MIT",
  "keywords": [
    "sftp",
    "scp",
    "ssh",
    "file transfer",
    "dual pane"
  ],
  "l10n": "./l10n",
  "overrides": {
    "minimatch": "11.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DrWhiteLetter/FileTandem.git"
  },
  "bugs": {
    "url": "https://github.com/DrWhiteLetter/FileTandem/issues"
  },
  "homepage": "https://github.com/DrWhiteLetter/FileTandem#readme",
  "author": "Tobias Kohlhepp"
}
