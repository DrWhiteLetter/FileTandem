{
  "name": "xscp",
  "displayName": "xScp",
  "description": "Entwicklungsprototyp eines SFTP-/SCP-Dateimanagers für VS Code Desktop.",
  "version": "0.0.4",
  "private": true,
  "publisher": "xscp-dev",
  "type": "module",
  "engines": {
    "vscode": "^1.140.0",
    "node": ">=22.13.1"
  },
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "xscp.openManager",
        "title": "xScp: Dateimanager öffnen"
      },
      {
        "command": "xscp.verifyLocalFile",
        "title": "xScp: Lokalen Dateizugriff nachweisen"
      },
      {
        "command": "xscp.verifySshHostKey",
        "title": "xScp: SSH-Host-Key prüfen"
      },
      {
        "command": "xscp.openEditorProof",
        "title": "xScp: SFTP-Datei im Editor öffnen"
      },
      {
        "command": "xscp.enableEditorEditing",
        "title": "xScp: Remote-Bearbeitung freigeben"
      },
      {
        "command": "xscp.lockEditorFile",
        "title": "xScp: Remote-Datei sperren"
      },
      {
        "command": "xscp.refreshConnections",
        "title": "xScp: Verbindungsansicht aktualisieren",
        "icon": "$(refresh)"
      },
      {
        "command": "xscp.addProfile",
        "title": "xScp: Profil anlegen",
        "icon": "$(add)"
      },
      {
        "command": "xscp.editProfile",
        "title": "xScp: Profil bearbeiten"
      },
      {
        "command": "xscp.deleteProfile",
        "title": "xScp: Profil löschen"
      },
      {
        "command": "xscp.exportProfiles",
        "title": "xScp: Profile ohne Geheimnisse exportieren"
      },
      {
        "command": "xscp.forgetCredentials",
        "title": "xScp: Gespeicherte Anmeldung vergessen"
      },
      {
        "command": "xscp.connectProfile",
        "title": "xScp: Profil verbinden"
      },
      {
        "command": "xscp.disconnectProfile",
        "title": "xScp: Verbindung trennen"
      },
      {
        "command": "xscp.openDemo",
        "title": "xScp: Mock-Demo öffnen"
      },
      {
        "command": "xscp.openProfile",
        "title": "xScp: Profil öffnen",
        "icon": "$(plug)"
      },
      {
        "command": "xscp.quickConnect",
        "title": "xScp: Schnellverbindung",
        "icon": "$(plug)"
      },
      {
        "command": "xscp.favoriteProfile",
        "title": "xScp: Profilfavorit umschalten",
        "icon": "$(star-empty)"
      },
      {
        "command": "xscp.reconnectProfile",
        "title": "xScp: Wiederverbinden",
        "icon": "$(refresh)"
      },
      {
        "command": "xscp.showTransfers",
        "title": "xScp: Transfers anzeigen"
      },
      {
        "command": "xscp.uploadFromExplorer",
        "title": "xScp: Auswahl hochladen"
      },
      {
        "command": "xscp.newRemoteFile",
        "title": "xScp: Neue Remote-Datei anlegen"
      },
      {
        "command": "xscp.reviewRemoteFile",
        "title": "xScp: Aktuellen Serverstand ansehen"
      },
      {
        "command": "xscp.acceptEditorReview",
        "title": "xScp: Verglichenen Serverstand als Basis übernehmen"
      },
      {
        "command": "xscp.diffRemoteFile",
        "title": "xScp: Server und Editor vergleichen"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xscp",
          "title": "xScp",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "xscp": [
        {
          "id": "xscp.connections",
          "name": "Verbindungen"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "xscp.refreshConnections",
          "when": "view == xscp.connections",
          "group": "navigation"
        },
        {
          "command": "xscp.addProfile",
          "when": "view == xscp.connections",
          "group": "navigation"
        },
        {
          "command": "xscp.quickConnect",
          "when": "view == xscp.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "xscp.openProfile",
          "when": "view == xscp.connections && viewItem == xscpProfile",
          "group": "xscp"
        },
        {
          "command": "xscp.reconnectProfile",
          "when": "view == xscp.connections && viewItem == xscpProfile",
          "group": "xscp"
        },
        {
          "command": "xscp.disconnectProfile",
          "when": "view == xscp.connections && viewItem == xscpProfile",
          "group": "xscp"
        },
        {
          "command": "xscp.editProfile",
          "when": "view == xscp.connections && viewItem == xscpProfile",
          "group": "xscp"
        },
        {
          "command": "xscp.favoriteProfile",
          "when": "view == xscp.connections && viewItem == xscpProfile",
          "group": "xscp"
        },
        {
          "command": "xscp.deleteProfile",
          "when": "view == xscp.connections && viewItem == xscpProfile",
          "group": "xscp"
        }
      ],
      "explorer/context": [
        {
          "command": "xscp.uploadFromExplorer",
          "when": "resourceScheme == file",
          "group": "xscp"
        }
      ],
      "editor/title": [
        {
          "command": "xscp.enableEditorEditing",
          "when": "resourceScheme == xscp || resourceScheme == xscp-review",
          "group": "xscp"
        },
        {
          "command": "xscp.lockEditorFile",
          "when": "resourceScheme == xscp || resourceScheme == xscp-review",
          "group": "xscp"
        },
        {
          "command": "xscp.reviewRemoteFile",
          "when": "resourceScheme == xscp || resourceScheme == xscp-review",
          "group": "xscp"
        },
        {
          "command": "xscp.acceptEditorReview",
          "when": "resourceScheme == xscp || resourceScheme == xscp-review",
          "group": "xscp"
        },
        {
          "command": "xscp.diffRemoteFile",
          "when": "resourceScheme == xscp || resourceScheme == xscp-review",
          "group": "xscp"
        }
      ]
    },
    "configuration": {
      "title": "xScp",
      "properties": {
        "xscp.showHiddenFiles": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Versteckte Dateien in den xScp-Dateilisten anzeigen."
        },
        "xscp.demoScenario": {
          "type": "string",
          "enum": [
            "ready",
            "loading",
            "empty",
            "error",
            "disconnected"
          ],
          "default": "ready",
          "scope": "application",
          "description": "Darstellungszustand der Mock-Dateilisten; baut keine SSH-Verbindung auf."
        },
        "xscp.editorPollInterval": {
          "type": "integer",
          "default": 5,
          "minimum": 2,
          "maximum": 60,
          "scope": "application",
          "description": "Prüfintervall in Sekunden für die aktive SFTP-Editor-Datei (2–60). Keine Verzeichnisüberwachung."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "xscp.connections",
        "contents": "Noch keine Serverprofile.\n[Profil anlegen](command:xscp.addProfile)\n[Schnellverbindung](command:xscp.quickConnect)\n[Lokalen Dateimanager öffnen](command:xscp.openManager)"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && node scripts/start.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run test:unit && npm run build && node scripts/test-extension.mjs",
    "vscode:prepublish": "npm run build",
    "fixtures:init": "node scripts/ssh-fixtures.mjs init",
    "fixtures:start": "node scripts/ssh-fixtures.mjs start",
    "fixtures:stop": "node scripts/ssh-fixtures.mjs stop",
    "fixtures:reset": "node scripts/ssh-fixtures.mjs reset",
    "fixtures:verify": "node scripts/ssh-fixtures.mjs verify",
    "fixtures:status": "node scripts/ssh-fixtures.mjs status",
    "test:unit": "node --test test/unit/*.test.js",
    "test:host-keys": "node --test --test-concurrency=1 test/integration/host-keys.test.js",
    "test:sftp": "node --test --test-concurrency=1 test/integration/sftp-streaming.test.js",
    "test:scp": "node --test --test-concurrency=1 test/integration/scp.test.js",
    "test:auth": "node --test --test-concurrency=1 test/integration/authentication.test.js",
    "test:packaging": "node scripts/test-packaging.mjs",
    "test:editor": "node --test test/integration/editor.test.js && npm run build && node scripts/test-editor.mjs",
    "test:editor:remote": "npm run build && node scripts/test-editor.mjs --remote",
    "lint": "eslint .",
    "quality": "npm run lint && npm run check && npm run test:unit && npm run test:webview && npm run build",
    "test:webview": "node --test test/webview/*.test.js",
    "package": "node scripts/package.mjs",
    "test:installed": "node scripts/test-installed.mjs",
    "test:browser": "node --test --test-concurrency=1 test/integration/browser.test.js",
    "test:browser:installed": "node scripts/test-browser-installed.mjs",
    "test:transfers": "node --test --test-concurrency=1 test/integration/transfers.test.js",
    "test:protocols": "node --test --test-concurrency=1 test/integration/host-keys.test.js test/integration/authentication.test.js test/integration/sftp-streaming.test.js test/integration/scp.test.js test/integration/scp-engine.test.js test/integration/transfers.test.js test/integration/resume.test.js test/integration/transfer-auth.test.js test/integration/browser.test.js"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/vscode": "1.138.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "27.4.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onWebviewPanel:xscp.demo",
    "onWebviewPanel:xscp.browser"
  ]
}
