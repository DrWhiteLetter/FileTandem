{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.js",
    "webview/src/**/*.js",
    "webview/src/**/*.jsx",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".vscode-test"
  ]
}
